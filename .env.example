# ── Core ─────────────────────────────────────────────
NODE_ENV=development
# Postgres. Railway injects this on the api/worker services via ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relay
# Redis for BullMQ and rate limits. Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379
# Public base URL of apps/api, used to build Twilio webhook, voice WebSocket, and OAuth callback URLs (ngrok locally)
PUBLIC_API_URL=https://your-tunnel.ngrok.app
# Public base URL of apps/web. Used in SMS links, CORS, and OAuth redirects back to the web account page
PUBLIC_WEB_URL=http://localhost:3000
API_PORT=4000
# 32-byte base64 key for AES-256-GCM encryption of OAuth tokens: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Signs mobile/web session JWTs and OAuth state: openssl rand -base64 48
JWT_SECRET=
# Shown in HELP replies, legal pages, and the app
SUPPORT_EMAIL=
# Legal name that operates Relay, shown on /privacy and /terms (required for 10DLC)
LEGAL_ENTITY=

# ── Twilio ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Relay number users text and call (E.164)
TWILIO_PHONE_NUMBER=+15555550100
# Messaging Service tied to the approved A2P 10DLC campaign
TWILIO_MESSAGING_SERVICE_SID=
# Twilio Verify service for phone sign-in codes
TWILIO_VERIFY_SERVICE_SID=
# Optional ConversationRelay voice. Defaults to Twilio's default provider and voice
VOICE_TTS_PROVIDER=
VOICE_NAME=

# ── Models ───────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
# Default brain for new users: claude | gpt | perplexity
DEFAULT_MODEL=claude
# Model IDs, kept in env so upgrades don't need a deploy. *_FAST_MODEL is used on phone calls
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=
OPENAI_FAST_MODEL=
PERPLEXITY_MODEL=sonar-pro
# USD per million tokens as "input/output", used for the daily spend cap.
# Update alongside the model ID. Unset prices fall back to a conservative 15/75.
CLAUDE_PRICE=
CLAUDE_FAST_PRICE=
OPENAI_PRICE=
OPENAI_FAST_PRICE=
PERPLEXITY_PRICE=

# ── Google OAuth (Gmail + Calendar) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud console.
# Leave blank to use {PUBLIC_API_URL}/oauth/google/callback
GOOGLE_REDIRECT_URI=

# ── Limits and access ────────────────────────────────
# Per-user daily model spend cap in USD cents
DAILY_SPEND_CAP_CENTS=300
# New accounts need an invite code (pnpm --filter @relay/api invite:create)
INVITE_ONLY=true
# Development only: accept this code at sign-in instead of calling Twilio Verify.
# The API refuses to start with this set when NODE_ENV=production.
DEV_LOGIN_CODE=

# ── Web / mobile (public, safe to ship to clients) ───
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_RELAY_NUMBER=+15555550100
