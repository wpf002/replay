# Run `pnpm configure` to fill this in interactively. It checks each key against the live service.

# ── Core ─────────────────────────────────────────────
NODE_ENV=development
# Postgres. Railway injects this on the api/worker services via ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relay
# Redis for BullMQ and rate limits. Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379
# Public base URL of apps/api, used to build Twilio webhook, voice WebSocket, and OAuth callback URLs.
# Locally, `pnpm tunnel` sets this and points Twilio at it.
PUBLIC_API_URL=https://your-tunnel.trycloudflare.com
# Public base URL of apps/web. Used in SMS links, CORS, and OAuth redirects back to the web account page
PUBLIC_WEB_URL=http://localhost:3000
# Local API port. Hosts like Railway set PORT instead, which the API also reads.
API_PORT=4000
# pino level: trace | debug | info | warn | error | silent
LOG_LEVEL=info
# 32-byte base64 key for AES-256-GCM encryption of OAuth tokens: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Signs mobile/web session JWTs and OAuth state: openssl rand -base64 48
JWT_SECRET=
# Shown in HELP replies, legal pages, and the app
SUPPORT_EMAIL=
# Legal name that operates Relay, shown on /privacy and /terms (required for 10DLC)
LEGAL_ENTITY=

# ── Twilio ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Relay number users text and call (E.164)
TWILIO_PHONE_NUMBER=+15555550100
# Messaging Service tied to the approved A2P 10DLC campaign
TWILIO_MESSAGING_SERVICE_SID=
# Twilio Verify service for phone sign-in codes
TWILIO_VERIFY_SERVICE_SID=
# Optional ConversationRelay voice. Defaults to Twilio's default provider and voice
VOICE_TTS_PROVIDER=
VOICE_NAME=

# ── Models ───────────────────────────────────────────
# Relay's own keys. People can connect their own in the app; theirs is used first.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
# true: never use the keys above for people. Everyone connects their own Claude, ChatGPT, or Perplexity key.
REQUIRE_USER_MODEL_KEYS=false
# Default brain for new users: claude | gpt | perplexity
DEFAULT_MODEL=claude
# Model IDs, kept in env so upgrades don't need a deploy. *_FAST_MODEL is used on phone calls
CLAUDE_MODEL=claude-opus-5
CLAUDE_FAST_MODEL=claude-haiku-4-5
OPENAI_MODEL=
OPENAI_FAST_MODEL=
PERPLEXITY_MODEL=sonar-pro
# USD per million tokens as "input/output", used for the daily spend cap.
# Update alongside the model ID and check each provider's pricing page. Unset prices fall back to a
# conservative 15/75. Perplexity per-request search fees are not counted.
CLAUDE_PRICE=5/25
CLAUDE_FAST_PRICE=1/5
OPENAI_PRICE=
OPENAI_FAST_PRICE=
PERPLEXITY_PRICE=3/15

# ── Relay's browser (booking, ordering, forms) ───────
# Chrome with one profile per person, holding their site sign-ins. Keep the directory on
# private disk. Defaults to ~/.relay/browser-profiles and the installed Google Chrome.
BROWSER_PROFILE_DIR=
BROWSER_CHANNEL=chrome
# A Chromium binary instead of installed Chrome (containers)
BROWSER_EXECUTABLE_PATH=
# Model that drives the browser; needs the browser toolset (Claude Opus 5, Sonnet 5, Fable 5).
# Defaults to CLAUDE_MODEL when it supports it, else claude-sonnet-5.
COMPUTER_MODEL=
# input/output USD per million tokens for COMPUTER_MODEL. Defaults to CLAUDE_PRICE.
COMPUTER_PRICE=

# ── Google OAuth (Gmail + Calendar) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud console. For development,
# http://localhost:4000/oauth/google/callback doesn't change when the tunnel URL does.
# Leave blank to use {PUBLIC_API_URL}/oauth/google/callback
GOOGLE_REDIRECT_URI=

# ── Limits and access ────────────────────────────────
# Per-user daily spend on Relay's model keys, in USD cents. People's own keys aren't capped.
DAILY_SPEND_CAP_CENTS=300
# New accounts need an invite code (pnpm --filter @relay/api invite:create)
INVITE_ONLY=true
# Development only: accept this code at sign-in instead of calling Twilio Verify.
# The API refuses to start with this set when NODE_ENV=production.
DEV_LOGIN_CODE=

# ── Web / mobile (public, safe to ship to clients) ───
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_RELAY_NUMBER=+15555550100

# ── Tests ────────────────────────────────────────────
# DB-backed tests run only when this is set. Use a separate database: tests truncate it.
TEST_DATABASE_URL=
# Defaults to redis://localhost:6379/1 so tests never touch dev queues
TEST_REDIS_URL=
