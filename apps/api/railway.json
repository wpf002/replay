{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm turbo run build --filter=@relay/api",
    "watchPatterns": ["apps/api/**", "packages/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @relay/db db:deploy && pnpm --filter @relay/api start",
    "restartPolicyType": "ON_FAILURE"
  }
}
