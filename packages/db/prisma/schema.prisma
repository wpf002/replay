generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Channel {
  SMS
  VOICE
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum Role {
  USER
  ASSISTANT
  TOOL
}

enum ModelId {
  CLAUDE
  GPT
  PERPLEXITY
}

enum OAuthProvider {
  GOOGLE
}

enum ActionStatus {
  PENDING
  AWAITING_CONFIRMATION
  CONFIRMED
  DENIED
  EXPIRED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ActionRisk {
  LOW
  MEDIUM
  HIGH
}

model User {
  id             String    @id @default(cuid())
  phone          String    @unique // E.164
  name           String?
  timezone       String    @default("America/Chicago")
  defaultModel   ModelId   @default(CLAUDE)
  pinHash        String?
  pinFailures    Int       @default(0)
  pinLockedUntil DateTime?
  smsOptInAt     DateTime?
  smsOptOutAt    DateTime?
  // Bumped to revoke every issued session JWT (sign out everywhere).
  tokenVersion   Int       @default(0)
  inviteId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invite        Invite?        @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  connections   Connection[]
  conversations Conversation[]
  actions       Action[]
  memories      Memory[]
  reminders     Reminder[]
  usage         Usage[]
}

model Connection {
  id              String        @id @default(cuid())
  userId          String
  provider        OAuthProvider
  accountEmail    String?
  scopes          String[]
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Conversation {
  id            String    @id @default(cuid())
  userId        String
  channel       Channel
  direction     Direction @default(INBOUND)
  callSid       String?   @unique
  // Set on outbound calls Relay places for an Action (bookings, errands).
  actionId      String?   @unique
  startedAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())
  endedAt       DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        Action?   @relation("ActionCall", fields: [actionId], references: [id], onDelete: SetNull)
  messages      Message[]
  actions       Action[]  @relation("ActionSource")

  @@index([userId, channel, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  direction      Direction
  role           Role
  model          ModelId?
  content        String
  twilioSid      String?      @unique
  // Citations, tool names, delivery errors.
  metadata       Json?
  // Inbound only: set once Relay has answered it, or when it was a keyword/confirmation handled
  // without the agent. Unhandled inbound messages are what the next agent turn reads.
  handledAt      DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Action {
  id                   String        @id @default(cuid())
  userId               String
  type                 String // tool name, e.g. gmail_send, calendar_create, place_call
  status               ActionStatus  @default(PENDING)
  // Exact text shown to the user before they confirm. Built from the payload, never by the model.
  summary              String
  payload              Json
  result               Json?
  error                String?
  risk                 ActionRisk    @default(MEDIUM)
  requiresConfirmation Boolean       @default(true)
  requiresPin          Boolean       @default(false)
  // Requested while untrusted content (email, web, calendar) was in context.
  tainted              Boolean       @default(false)
  channel              Channel       @default(SMS)
  conversationId       String?
  expiresAt            DateTime?
  confirmedAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation         Conversation? @relation("ActionSource", fields: [conversationId], references: [id], onDelete: SetNull)
  call                 Conversation? @relation("ActionCall")

  @@index([userId, status])
  @@index([userId, createdAt])
}

model Memory {
  id              String   @id @default(cuid())
  userId          String
  fact            String
  sourceMessageId String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Reminder {
  id        String    @id @default(cuid())
  userId    String
  runAt     DateTime
  body      String
  jobId     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([runAt])
  @@index([userId, runAt])
}

/// One row per model call. Summed per day for the spend cap.
model Usage {
  id            String   @id @default(cuid())
  userId        String
  model         ModelId
  providerModel String
  channel       Channel?
  inputTokens   Int
  outputTokens  Int
  costMicros    Int // USD * 1e6
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  maxUses   Int       @default(1)
  uses      Int       @default(0)
  note      String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  users     User[]
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}
